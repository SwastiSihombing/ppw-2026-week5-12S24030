  "item": [
    {
      "name": "(a) SOAP",
      "item": [
        {
          "name": "GET WSDL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Memuat operasi', () => pm.expect(pm.response.text()).to.include('CheckClearanceStatus'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{host}}/soap/sipus.wsdl",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Masih punya pinjaman (is_cleared=false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is_cleared false', () => pm.expect(pm.response.text()).to.include('<is_cleared>false</is_cleared>'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "url": "{{host}}/soap/sipus",
            "auth": {
              "type": "noauth"
            },
            "description": "NIM 12S24001 memiliki pinjaman aktif dari seeder.",
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"\n               xmlns:m=\"http://sipus.del.ac.id/soap/sipus\">\n    <soap:Body>\n        <m:CheckClearanceStatus>\n            <nim_peminjam>12S24001</nim_peminjam>\n        </m:CheckClearanceStatus>\n    </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          }
        },
        {
